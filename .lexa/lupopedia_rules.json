            "category": "architecture",
            "status": "active"
        },
        {
            "id": "DB003",
            "text": "All database access must use PDO_DB; prepared statements only; no raw SQL or legacy patterns",
            "enforcement": "error",
            "scope": [
                "all_agents"
            ],
            "source_path": "lupo-rules/root/pdo-db-database-access-doctrine.md",
