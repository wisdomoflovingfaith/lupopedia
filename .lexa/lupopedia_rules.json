{
    "rules": [
        {
            "id": "CONSTITUTION001",
            "text": "Lupopedia Constitutional Root Rules - absolute, non-negotiable doctrine",
            "enforcement": "error",
            "scope": [
                "all_agents"
            ],
            "source_path": "lupo-rules/root/LUPOPEDIA_CONSTITUTIONAL_ROOT_RULES.md",
            "slug": "LUPOPEDIA_CONSTITUTIONAL_ROOT_RULES",
            "category": "constitutional",
            "status": "active"
        },
        {
            "id": "CTX001",
            "text": "All systemic operations and tracking operate through specific Channels and Federation Nodes. Offline interactions or non-database IDE contexts must fallback to embedding session metadata securely within L-LUPO-* file headers.",
            "enforcement": "error",
            "scope": [
                "all_agents"
            ],
            "source_path": "lupo-rules/root/channels-federation-offline-session-doctrine.md",
            "slug": "channels-federation-offline-session-doctrine",
            "category": "context",
            "status": "active"
        },
        {
            "id": "DB001",
            "text": "Mandatory prohibition of database-side logic; all logic in application code",
            "enforcement": "error",
            "scope": [
                "all_agents"
            ],
            "source_path": "lupo-rules/root/database-logic-prohibition-doctrine.md",
            "slug": "database-logic-prohibition-doctrine",
            "category": "database",
            "status": "active"
        },
        {
            "id": "DB008",
            "text": "When the database is impenetrable, offline, or strictly isolated from an IDE Agent's execution scope, operations must fallback to structured filesystem artifacts (e.g., CSVs, Markdown, TOON json). The artifact must be strictly formatted to allow native bi-directional importing into the database upon restoration.",
            "enforcement": "error",
            "scope": [
                "all_agents"
            ],
            "source_path": "lupo-rules/root/database-offline-fallback-import-doctrine.md",
            "slug": "database-offline-fallback-import-doctrine",
            "category": "database",
            "status": "active"
        },
        {
            "id": "ARC001",
            "text": "FLIP/FLARE have been replaced by LUPOPEDIA HEADERS formatting",
            "enforcement": "error",
            "scope": [
                "all_agents"
            ],
            "source_path": "lupo-rules/root/flip-doctrine.md",
            "slug": "flip-doctrine",
            "category": "headers",
            "status": "active"
        },
        {
            "id": "ACT001",
            "text": "IDE Agents must explicitly know their systemic identity (actor_id), their paired human orchestrator (auth_user_id), and operate as discrete actors. In IDE environments, the logged-in user account maps directly to an auth_user which dictates the orchestration actor pairing.",
            "enforcement": "error",
            "scope": [
                "all_agents"
            ],
            "source_path": "lupo-rules/root/ide-agent-identity-actor-pairing-doctrine.md",
            "slug": "ide-agent-identity-actor-pairing-doctrine",
            "category": "identity",
            "status": "active"
        },
        {
            "id": "LIL001",
            "text": "Lilith operates as a non-interfering reviewer. Lilith must not modify other agents' work without explicit review context; must not block or delay other agents' operations; outputs must be clearly attributable; presence must not alter permissions for other agents.",
            "enforcement": "error",
            "scope": [
                "all_agents"
            ],
            "source_path": "lupo-rules/root/lilith-noninterference-doctrine.md",
            "slug": "lilith-noninterference-doctrine",
            "category": "agent_behavior",
            "status": "active"
        },
        {
            "id": "DB002",
            "text": "Two-place schema changes, no direct DB, no scoop mysql, TOON source of truth",
            "enforcement": "error",
            "scope": [
                "all_agents"
            ],
            "source_path": "lupo-rules/root/migration-doctrine.md",
            "slug": "migration-doctrine",
            "category": "database",
            "status": "active"
        },
        {
            "id": "ARC002",
            "text": "This project does NOT use Laravel or any framework middleware. Plain PHP only",
            "enforcement": "error",
            "scope": [
                "all_agents"
            ],
            "source_path": "lupo-rules/root/no-laravel-no-middleware.md",
