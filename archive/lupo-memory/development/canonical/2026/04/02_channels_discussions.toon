prd_sections[5]{pk,summary,title}:
  1,"Defines channels, threads, dialog messages, and content linkage for structured discussions.",Overview and Scope
  2,Specifies federation-node and channel-key filesystem layout with thread manifests and typed folders.,Directory and Thread Model
  3,"Defines lupo_channels, lupo_dialog_threads, lupo_dialog_messages, and supporting channel state tables.",Data Model and Tables
  4,Enforces actor-based attribution and deterministic routing through channel_id and dialog_thread_id.,Identity and Routing
  5,"Requires BIGINT UTC, no foreign keys, no triggers, explicit IDs, and soft-delete conventions.",Constitutional Constraints

prd_rules[5]{pk,rule_name,section_pk,severity,summary}:
  1,channel_thread_path_structure,2,high,Filesystem channel threads must follow federation_node_id/channel_key/thread_key structure.
  2,dialog_pk_naming_doctrine,3,critical,"Primary keys must be dialog_thread_id and dialog_message_id, never generic id."
  3,actor_identity_for_messages,4,critical,Message attribution must resolve to actor identity; from_actor_id request mapping is API to DB actor_id.
  4,soft_delete_required,5,high,Discussion rows must use is_deleted and deleted_ymdhis instead of hard deletes.
  5,db_logic_prohibited,5,critical,"No foreign keys, no triggers, and no database-side automation in channels namespace."

definitions[5]{pk,meaning,term}:
  1,Human-readable channel identifier used in filesystem and channel registry.,channel_key
  2,Human-readable thread identifier under a channel key path.,thread_key
  3,Primary key for a discussion thread row in lupo_dialog_threads.,dialog_thread_id
  4,Primary key for an individual message row in lupo_dialog_messages.,dialog_message_id
  5,"Required metadata file defining thread purpose, status, and lifecycle on filesystem.",thread_manifest

