    "title": "Root Constitutional Requirements",
    "summary": "Constitutional guardrails for schema, runtime, identity, and machine-readable data hygiene.",
    "constitutional_rules": [
      "No foreign keys",
      "No database logic",
      "No frameworks or middleware",
      "No emoji in machine-readable data",
      "No UNIX timestamps in canonical fields",
      "No AUTO_INCREMENT for reserved-id tables",
      "No UUIDs for canonical IDs",
      "No Redis session dependency"
    ],
