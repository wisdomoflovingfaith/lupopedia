      "prd_slug": "rose-synthetic-dialog",
      "source_path": "docs/prd/36_rose_multi_persona_synthetic_dialog.md"
    }
  ],
  "prd_sections": [
    {
      "pk": 1,
      "title": "Overview and Mental Model",
      "summary": "Defines ROSE as orchestration service that voices canonical personas with explicit synthetic provenance."
    },
    {
      "pk": 2,
      "title": "Goals and User-visible Behavior",
      "summary": "Specifies trigger rules, persona selection, metadata keys, rendering cues, and visibility controls."
    },
    {
      "pk": 3,
      "title": "Data Model and Security",
      "summary": "Uses lupo_dialog_messages with from_actor_id as voiced persona and metadata_json for rose_synthesis provenance."
    },
    {
      "pk": 4,
      "title": "KAIROS Handoff and Safety Limits",
      "summary": "Requires post-batch consolidation handoff and enforces rate/length safety constraints."
    },
    {
      "pk": 5,
      "title": "Implementation Phases and References",
      "summary": "Defines dependency-ordered rollout and authoritative references across PRDs and doctrines."
    }
  ],
  "prd_rules": [
    {
      "pk": 1,
      "section_pk": 1,
      "rule_name": "rose_is_orchestrator_not_speaker",
      "severity": "critical",
      "summary": "ROSE coordinates synthetic insertion; transcript from_actor_id must always be voiced persona, never ROSE stand-in."
    },
    {
      "pk": 2,
      "section_pk": 2,
      "rule_name": "synthetic_provenance_required",
      "severity": "critical",
      "summary": "Every synthetic message row must include metadata_json.rose_synthesis and related provenance fields."
    },
    {
      "pk": 3,
      "section_pk": 3,
      "rule_name": "server_side_authority_only",
      "severity": "critical",
      "summary": "Synthetic insertion is server-controlled; client must not arbitrarily set from_actor_id for persona spoofing."
    },
    {
      "pk": 4,
      "section_pk": 4,
      "rule_name": "kairos_post_batch_handoff",
      "severity": "high",
      "summary": "After each ROSE batch, PHP should pass coordination summary to KairosConsolidationService recordObservation."
    },
    {
      "pk": 5,
      "section_pk": 4,
      "rule_name": "message_length_and_rate_limits",
      "severity": "high",
      "summary": "Synthetic message text length and batch rate limits must be bounded by explicit product constraints."
    }
  ],
  "definitions": [
    {
      "pk": 1,
      "term": "rose_synthesis",
      "meaning": "Boolean metadata flag indicating message was synthesized by ROSE orchestration."
    },
    {
      "pk": 2,
      "term": "synthetic_choir",
      "meaning": "Multi-persona injected dialog sequence voiced as distinct canonical actors."
    },
    {
      "pk": 3,
      "term": "voiced_persona",
      "meaning": "Canonical actor identity assigned to from_actor_id for each synthetic line."
    },
    {
      "pk": 4,
      "term": "rose_visibility",
      "meaning": "Visibility control metadata value such as actor_only or visitor_visible."
    },
    {
      "pk": 5,
      "term": "rose_batch_id",
      "meaning": "Shared identifier grouping synthetic messages produced in one orchestration turn."
    }
  ],
