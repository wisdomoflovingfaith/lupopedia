prd_rules[5]{pk,rule_name,section_pk,severity,summary}:
  1,filesystem_agent_discovery_authority,2,critical,"Agent definitions are discovered from agents directories as primary authority, not database rows."
  2,agents_actors_strict_separation,4,critical,Agents are templates while actors are runtime entities; identity layers must not be conflated.
  3,metadata_json_schema_required,4,high,Agent metadata_json and related structures must follow canonical schema requirements.
  4,tool_call_auditability,3,high,"Agent tool-call events must be attributable, retained, and reviewable in runtime tables."
  5,needs_review_requires_reason,5,critical,Memory edges with status needs_review require explicit review_reason.

