prd_rules[5]{pk,rule_name,section_pk,severity,summary}:
  1,database_constitutional_constraints,1,critical,"No foreign keys, triggers, or stored procedures; timestamps are BIGINT UTC; IDs are generated in application logic."
  2,agents_vs_actors_separation,2,critical,Agents are immutable templates while actors are runtime contextual entities; do not conflate identity layers.
  3,session_cleanup_soft_delete,3,high,"Expired sessions are soft-deleted by setting is_deleted, deleted_ymdhis, and updated_ymdhis."
  4,edge_dimensions_required,5,critical,"Every memory edge requires type, context, status, and direction dimensions."
  5,review_reason_required_when_needs_review,5,critical,"When edge_status is needs_review, review_reason must be populated."

