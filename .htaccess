# Lupopedia .htaccess
# No mod_rewrite front-controller routing — use explicit PHP entry points:
#   index.php?slug=…  index.php?resolved_uri=…  login.php  admin.php  channel.php  …
# Keep in sync with lupo-install/InstallWizardHtaccessWriter.php (Softaculous zips omit .htaccess; installer writes this body).

# Default document (no rewrite: open site via /subdir/ or /subdir/index.php?slug=…)
DirectoryIndex index.php index.html

# Prevent directory listing
Options -Indexes

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Security: Deny access to hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to config files
<FilesMatch "^(lupopedia-config\.php|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent access to sensitive file types in webroot (adjust server config if you must expose a static JSON asset here)
<FilesMatch "\.(sql|log|md|yaml|yml|json|bak|backup|old)$">
    Order allow,deny
    Deny from all
</FilesMatch>
