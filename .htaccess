# Lupopedia .htaccess
# Clean URLs without hardcoding the installation directory

<IfModule mod_rewrite.c>
RewriteEngine On

# DO NOT SET RewriteBase — this allows Lupopedia to run in ANY subfolder
# Apache automatically detects the current directory.

# Prevent directory listing
Options -Indexes

# Allow static assets to be served directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|json|xml|map)$ [NC]
RewriteRule ^ - [L]

# Allow access to existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Explicit entry points
RewriteRule ^my-channel\.php$ - [L]

# Block PHP files in lupo-includes (security)
RewriteCond %{REQUEST_URI} ^.*/lupo-includes/.*\.php$ [NC]
RewriteRule ^ - [F,L]

# Block access to sensitive directories
RewriteCond %{REQUEST_URI} ^.*/(database|config|\.git)/ [NC]
RewriteRule ^ - [F,L]

# Route everything else to index.php
RewriteRule ^(.*)$ index.php?slug=$1 [L,QSA]

# Security: Deny access to hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to config files
<FilesMatch "^(lupopedia-config\.php|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevent access to sensitive file types
<FilesMatch "\.(sql|log|md|yaml|yml|json|bak|backup|old)$">
    Order allow,deny
    Deny from all
</FilesMatch>
