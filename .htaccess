# Lupopedia .htaccess
# Clean URLs without hardcoding the installation directory

<IfModule mod_rewrite.c>
RewriteEngine On

# DO NOT SET RewriteBase — this allows Lupopedia to run in ANY subfolder
# Apache automatically detects the current directory.

# Prevent directory listing
Options -Indexes

# Allow static assets to be served directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|json|xml|map)$ [NC]
RewriteRule ^ - [L]

# Allow access to existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Explicit entry points (do not rewrite to index.php)
RewriteRule ^admin\.php$ - [L]
RewriteRule ^my-channel\.php$ - [L]
RewriteRule ^channel\.php$ - [L]

# Standalone chat page (channel.php) — does not replace full /channels/N cockpit (index.php)
RewriteRule ^channel-chat/([0-9]+)/thread/([0-9]+)/?$ channel.php?channel_id=$1&thread_id=$2 [L,QSA]
RewriteRule ^channel-chat/([0-9]+)/?$ channel.php?channel_id=$1 [L,QSA]

# Pretty channel URLs (explicit; same outcome as catch-all slug, documents intent for operators)
RewriteRule ^channels/([0-9]+)/thread/([0-9]+)/?$ index.php?slug=channels/$1/thread/$2 [L,QSA]
RewriteRule ^channels/([0-9]+)/?$ index.php?slug=channels/$1 [L,QSA]

# Block PHP files in lupo-includes (security)
RewriteCond %{REQUEST_URI} ^.*/lupo-includes/.*\.php$ [NC]
RewriteRule ^ - [F,L]

# Block access to sensitive directories
RewriteCond %{REQUEST_URI} ^.*/(database|config|\.git)/ [NC]
RewriteRule ^ - [F,L]

# 4.0.18 T5: Funnel doctrine/qa/docs/flp to index.php with resolved_uri (full matched path)
# Requires mod_rewrite. Enable with: a2enmod rewrite (Debian/Ubuntu); LoadModule rewrite_module ... (httpd.conf)
RewriteRule ^(doctrine|qa|docs|flp)/(.+)$ index.php?resolved_uri=$1/$2 [QSA,L]

# Route everything else to index.php
RewriteRule ^(.*)$ index.php?slug=$1 [L,QSA]

# Security: Deny access to hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to config files
<FilesMatch "^(lupopedia-config\.php|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevent access to sensitive file types
<FilesMatch "\.(sql|log|md|yaml|yml|json|bak|backup|old)$">
    Order allow,deny
    Deny from all
</FilesMatch>
